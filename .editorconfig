root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4

[*.{toml,yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,css,html}]
indent_size = 2

[*.md]
indent_size = 2
# Two-space markdown hard breaks are meaningful in README badges/tables.
trim_trailing_whitespace = false

[{Cargo.lock,*.lock,THIRD-PARTY-NOTICES}]
trim_trailing_whitespace = false
insert_final_newline = unset

[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf
